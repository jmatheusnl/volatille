# Ambiente GitHub Pages
# O vídeo é embutido via iframe do YouTube para evitar arquivo pesado no repositório
VITE_VIDEO_MODE=youtube

# ⬇️ Substitua PENDENTE pelo ID do vídeo do YouTube quando estiver disponível
# Exemplo: para https://youtu.be/dQw4w9WgXcQ, o ID é dQw4w9WgXcQ
VITE_YOUTUBE_VIDEO_ID=PENDENTE
